{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1140px",
			"wideSize": "1280px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"palette": [
				{ "slug": "primary", "color": "#1E4FA3", "name": "Xanh dương (chủ đạo)" },
				{ "slug": "primary-dark", "color": "#163C7C", "name": "Xanh dương đậm" },
				{ "slug": "secondary", "color": "#F7C600", "name": "Vàng/Gold" },
				{ "slug": "accent", "color": "#E8312A", "name": "Đỏ (CTA)" },
				{ "slug": "ink", "color": "#15264A", "name": "Chữ navy đậm" },
				{ "slug": "muted", "color": "#5B6B86", "name": "Chữ phụ" },
				{ "slug": "light", "color": "#F2F6FC", "name": "Nền nhạt" },
				{ "slug": "line", "color": "#E2E7F1", "name": "Viền" },
				{ "slug": "white", "color": "#FFFFFF", "name": "Trắng" }
			],
			"gradients": [
				{ "slug": "brand", "gradient": "linear-gradient(120deg, #1E4FA3 0%, #163C7C 100%)", "name": "Gradient thương hiệu" },
				{ "slug": "brand-accent", "gradient": "linear-gradient(120deg, #163C7C 0%, #1E4FA3 60%, #E8312A 140%)", "name": "Gradient xanh-đỏ" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "'Be Vietnam Pro', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "'Lexend', 'Be Vietnam Pro', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Nhỏ" },
				{ "slug": "medium", "size": "1.0625rem", "name": "Vừa" },
				{ "slug": "large", "size": "1.375rem", "name": "Lớn", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "size": "2rem", "name": "Rất lớn", "fluid": { "min": "1.6rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "size": "2.75rem", "name": "Tiêu đề", "fluid": { "min": "2rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "size": "0.75rem", "name": "1" },
				{ "slug": "30", "size": "1.25rem", "name": "2" },
				{ "slug": "40", "size": "2rem", "name": "3" },
				{ "slug": "50", "size": "3rem", "name": "4" },
				{ "slug": "60", "size": "4.5rem", "name": "5" },
				{ "slug": "70", "size": "6rem", "name": "6" }
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|white", "text": "var:preset|color|ink" },
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "top": "0", "bottom": "0", "left": "clamp(1rem, 4vw, 2rem)", "right": "clamp(1rem, 4vw, 2rem)" }
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|ink" },
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "700", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"link": {
				"color": { "text": "var:preset|color|primary" },
				":hover": { "color": { "text": "var:preset|color|accent" } }
			},
			"button": {
				"color": { "background": "var:preset|color|accent", "text": "var:preset|color|white" },
				"border": { "radius": "8px" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.6rem", "right": "1.6rem" } },
				"typography": { "fontWeight": "700" },
				":hover": { "color": { "background": "var:preset|color|primary-dark", "text": "var:preset|color|white" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "800", "fontSize": "1.2rem" },
				"color": { "text": "var:preset|color|ink" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Trang không tiêu đề", "postTypes": ["page"] }
	]
}
